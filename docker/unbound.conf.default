# unbound для WireGuard-туннеля. Слушает ТОЛЬКО адреса wg0.
server:
  verbosity: 1
  interface: 10.8.0.1
  interface: fd42:8:8::1
  port: 53
  do-ip4: yes
  do-ip6: yes
  do-udp: yes
  do-tcp: yes

  # доступ разрешён только VPN-подсетям; всё прочее — refuse (не открытый резолвер)
  access-control: 10.8.0.0/24 allow
  access-control: fd42:8:8::/64 allow
  access-control: 127.0.0.0/8 allow
  access-control: ::1 allow
  access-control: 0.0.0.0/0 refuse
  access-control: ::/0 refuse

  # DNSSEC + приватность
  auto-trust-anchor-file: "/config/unbound/root.key"
  harden-dnssec-stripped: yes
  harden-glue: yes
  qname-minimisation: yes
  hide-identity: yes
  hide-version: yes
  prefetch: yes
  rrset-roundrobin: yes

  # поведение процесса
  username: "unbound"
  directory: "/config/unbound"
  chroot: ""
  do-daemonize: no
  use-syslog: no
  logfile: ""

  # кэш (экономно, хост всего 715 МБ)
  msg-cache-size: 4m
  rrset-cache-size: 8m
  cache-min-ttl: 60
  cache-max-ttl: 86400
  num-threads: 1
  so-reuseport: yes
  minimal-responses: yes
